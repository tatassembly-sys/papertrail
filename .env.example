# ─── Required for core app ───────────────────────────────────────────────────

# MongoDB connection string. Railway Mongo plugin often provides MONGO_URL instead;
# the app accepts either (MONGODB_URI takes precedence).
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGO_URL=

# Database name (default: papertrail)
MONGODB_DB=papertrail

# Optional: Atlas/server selection timeout in ms (default: 5000)
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Stable API is on by default (Atlas-friendly). Set false for some community Mongo hosts:
# MONGODB_STABLE_API=false

# Connection pool (defaults: max 10, min 0) — tune for Atlas free tier if needed:
# MONGODB_MAX_POOL_SIZE=10
# MONGODB_MIN_POOL_SIZE=0

# Public site URL — preferred. On Railway, RAILWAY_PUBLIC_DOMAIN is used as fallback
# automatically for sitemap/RSS/OG if this is unset. For a custom domain, see the
# "Custom domain / DNS" section below before flipping this off localhost/Railway.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs admin/user session JWTs. MUST be at least 32 characters. Generate with:
#   openssl rand -base64 32
# JWT_SECRET is accepted as an alias.
AUTH_SECRET=
# JWT_SECRET=

# Single admin login. ADMIN_USERNAME is accepted as an alias for ADMIN_EMAIL.
ADMIN_EMAIL=admin@example.com
# ADMIN_USERNAME=

# bcrypt hash of the admin password — not the plaintext. Generate with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# Shared secret for cron HTTP endpoints (Bearer token).
# REQUIRED in production (NODE_ENV=production) — cron routes return 503 without it.
# Generate with: openssl rand -base64 32
CRON_SECRET=

# ─── Paper processing (required for ingestion / translation) ─────────────────

OPENROUTER_API_KEY=
# FREE models only. Default primary is OpenRouter’s free auto-router.
# Paid ids are ignored and forced to openrouter/free (see lib/openrouter.ts).
# OPENROUTER_MODEL=openrouter/free
# Optional comma-separated free fallbacks after the auto-router (must end in :free):
# OPENROUTER_FREE_MODELS=meta-llama/llama-3.3-70b-instruct:free,google/gemma-3-27b-it:free
# OPENROUTER_MAX_TOKENS=2500
# OPENROUTER_CHAT_MAX_TOKENS=800

# Optional SpaceXAI / xAI fallback when OpenRouter is down (never required).
# XAI_API_KEY=
# XAI_MODEL=grok-4.5

# Comma-separated arXiv category codes for the daily RSS sweep (optional override)
# ARXIV_RSS_CATEGORIES=cs.AI,cs.LG,astro-ph.CO

# PubMed E-utilities etiquette (optional but recommended)
# PUBMED_TOOL_NAME=paper-trail
# PUBMED_CONTACT_EMAIL=you@example.com

# ─── Newsletter / transactional email (optional) ─────────────────────────────
# Without RESEND_API_KEY, /api/health reports email:"log". Verify/reset/digest
# links are logged (and may appear in non-production API responses) instead of
# being sent. Register and subscribe still work.
#
# Resend setup: https://resend.com → API key → Domains → add your sending host.
# Add the SPF + DKIM TXT records Resend shows at your DNS registrar, wait until
# the domain shows Verified, then set NEWSLETTER_FROM to an address on that
# domain. EMAIL_FROM is accepted as an alias for NEWSLETTER_FROM.
#
# Smoke-test only (Resend onboarding inbox; not for production mail):
#   NEWSLETTER_FROM=Paper Trail <onboarding@resend.dev>
# Production example (after DNS verifies):
#   NEWSLETTER_FROM=Paper Trail <news@papertrailresearch.co.uk>
# RESEND_API_KEY=
# NEWSLETTER_FROM=Paper Trail <onboarding@resend.dev>
# EMAIL_FROM=

# ─── Custom domain / DNS (optional) ──────────────────────────────────────────
# Keep NEXT_PUBLIC_SITE_URL on the Railway *.up.railway.app host until DNS works.
# At your registrar (e.g. GoDaddy), point the apex/www CNAME or ALIAS at Railway
# (Settings → Networking → custom domain), or use Railway's DNS instructions.
# Then set NEXT_PUBLIC_SITE_URL to https://your.domain and redeploy so sitemap,
# RSS, OG, and email links use the custom host. papertrailresearch.co.uk is the
# intended production host when registrar DNS is finished.

# ─── Billing / Paper Trail Pro (optional — checkout stays off until set) ─────
# Create a Stripe product with two prices (GBP monthly + yearly) and paste IDs.
# Use sk_test_ / whsec_ from test mode until go-live; switch to live keys for prod.
# Checkout returns 503 until STRIPE_SECRET_KEY + both price IDs are set.
# Webhook endpoint: POST /api/billing/webhook
#   events: checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.paid, invoice.payment_failed
# Local tip: stripe listen --forward-to localhost:3000/api/billing/webhook
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# Optional display overrides (defaults: £8 / £72):
# BILLING_MONTHLY_LABEL=£8
# BILLING_YEARLY_LABEL=£72
# STRIPE_AUTOMATIC_TAX=false
# Comma-separated emails that always receive Pro (comps, owner) without Stripe:
# BILLING_GRANT_EMAILS=you@example.com

# ─── Social posting (all optional; leave blank to skip a platform) ───────────

# Facebook Page
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram (Graph API; token can fall back to FACEBOOK_PAGE_ACCESS_TOKEN)
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# INSTAGRAM_ACCESS_TOKEN=

# Reddit
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# REDDIT_SUBREDDIT=
# REDDIT_USER_AGENT=paper-trail/1.0

# X / Twitter API v2 (paid; disabled unless explicitly enabled)
# ENABLE_X_API_POSTING=false
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_SECRET=
